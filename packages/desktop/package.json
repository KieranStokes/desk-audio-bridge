{
  "private": true,
  "name": "xbox-audio-bridge",
  "description": "Desk Audio Bridge: an independent audio utility compatible with Xbox Remote Play",
  "version": "0.1.13",
  "license": "MIT",
  "author": "Desk Audio Bridge contributors; based on Greenlight by UnknownSKL",
  "main": "app/background.js",
  "scripts": {
    "prepare:release": "node scripts/prepare-release.cjs",
    "dev": "cross-env DEBUG=greenlight:* nextron",
    "build": "yarn prepare:release && nextron build",
    "build:signed": "yarn prepare:release && nextron build --no-pack && electron-builder --config electron-builder.signed.yml && pwsh -NoProfile -File scripts/verify-release.ps1 -RequireSignature",
    "verify:release": "node scripts/verify-packaged-licenses.cjs && pwsh -NoProfile -File scripts/verify-release.ps1",
    "lint": "eslint . --ext .ts && eslint renderer/ --ext .tsx",
    "lint:fix": "eslint . --ext .ts --fix && eslint renderer/ --ext .tsx --fix",
    "test": "node --test tests/audio-only-input.test.cjs tests/streaming-credentials.test.cjs",
    "test:smoke": "yarn prepare:release && cross-env CI=true nextron build --no-pack && cross-env CI=true playwright test -c playwright.config.ts",
    "test:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-packaged.ps1",
    "test-serve": "http-server app/ -p 3000",
    "postinstall": "electron-builder install-app-deps",
    "flatpak-build": "nextron build --no-pack && electron-builder --dir"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "debug": "^4.3.4",
    "electron-serve": "^3.0.0",
    "electron-store": "^8.1.0",
    "i18next": "^25.8.0",
    "ip-address": "^10.2.0",
    "react-i18next": "^17.0.12",
    "react-query": "^3.39.3",
    "uplot": "^1.6.30",
    "xal-node": "^1.1.6-beta2",
    "xbox-webapi": "^2.0.0-beta4",
    "xbox-xcloud-player": "0.2.11"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@electron/asar": "3.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.62.1",
    "@types/i18next": "^13.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-i18next": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "babel-loader": "^10.0.0",
    "electron": "43.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "http-server": "^14.1.1",
    "next": "^16.1.0",
    "nextron": "^10.0.0",
    "node-loader": "^2.1.0",
    "playwright": "^1.62.1",
    "rcedit": "5.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.34.5",
    "spdx-expression-parse": "4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
