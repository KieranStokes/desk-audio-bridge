{
  "private": true,
  "name": "greenlight",
  "description": "Desk Audio Bridge, a Windows Xbox Remote Play audio utility based on Greenlight",
  "author": "UnknownSKL <info+github@jimkroon.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KieranStokes/desk-audio-bridge.git"
  },
  "scripts": {
    "desktop": "corepack yarn workspace xbox-audio-bridge",
    "desktopv3": "corepack yarn workspace greenlight-desktop-v3",
    "docs": "corepack yarn workspace @greenlight/docs",
    "logger": "corepack yarn workspace @greenlight/logger",
    "platform": "corepack yarn workspace @greenlight/platform",
    "playground": "corepack yarn workspace @greenlight/platform-playground",
    "player": "corepack yarn workspace @greenlight/player",
    "pages": "corepack yarn workspace @greenlight/pages",
    "build:depsv3": "corepack yarn logger build && corepack yarn player build && corepack yarn platform build",
    "build:pages": "corepack yarn build:depsv3 && corepack yarn pages build",
    "deploy:pages": "corepack yarn pages deploy",
    "test:v3": "corepack yarn logger test && corepack yarn platform test",
    "postinstall": "patch-package"
  },
  "workspaces": [
    "packages/logger",
    "packages/player",
    "packages/pages",
    "packages/platform",
    "packages/platform-playground",
    "packages/desktop",
    "packages/desktop-v3",
    "packages/docs"
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "patch-package": "^8.0.1"
  }
}
